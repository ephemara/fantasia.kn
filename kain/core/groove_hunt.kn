// ============================================================================
// groove_hunt.kn — Fantasia 03: Tempo & Beat Stability Scanner
// (Adapted from TurboKain lag_hunt & frame_hunt)
//
// Scans audio for locked-in musical pulse, tempo (BPM), and rhythmic consistency:
//   1. Extracts onset energy envelope decimated to 100 Hz (10ms grid)
//   2. Computes direct autocorrelation R(tau) over the musical lag plane
//      spanning 50 BPM (lag 120) to 220 BPM (lag 27)
//   3. Resolves primary BPM with octave / subharmonic disambiguation
//   4. Calculates Pulse Clarity Metric (peak prominence / energy)
//   5. Verifies groove stability:
//      * LOCKED_GROOVE  (pulse >= 0.18 -> locked human metronome take)
//      * LOOSE_PULSE    (0.08 <= pulse < 0.18 -> loose strumming/chords)
//      * RUBATO_NOODLE  (pulse < 0.08 -> aimless searching / retuning)
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use _common::k_CreateFileA
use _common::k_ReadFile
use _common::k_WriteFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::GEN_WRITE
use _common::OPEN_EXISTING
use _common::CREATE_ALWAYS
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::bref
use _common::bstore
use _common::parse_int_text
use _common::parse_float_text
use _common::find_from
use _common::f32_of_quad
use _common::write_text_file
use _common::fmt_f3

pub fn groove_hunt_usage() -> String:
    var t: String = "================================================================================\n"
    t = t + " Fantasia Tempo & Groove Hunter (groove_hunt) 0.1.0\n"
    t = t + "================================================================================\n\n"
    t = t + "USAGE:\n"
    t = t + "  fantasia groove_hunt --in <audio.f32> [--fs <hz>]\n"
    t = t + "                       [--out groove.md] [--csv groove.csv] [--prove]\n\n"
    t = t + "FLAGS:\n"
    t = t + "  --in <path>        Input normalized float32 stream (.f32)\n"
    t = t + "  --fs <hz>          Sample rate in Hz (default: 22050)\n"
    t = t + "  --out <path>       Output Markdown report (default: groove.md)\n"
    t = t + "  --csv <path>       Output CSV groove database (default: groove.csv)\n"
    t = t + "  --prove            Run formal synthetic tempo detection prove battery\n"
    return t

pub fn groove_hunt_main(args: Array<String>) -> Int with Unsafe:
    var in_path: String = ""
    var out_path: String = "groove.md"
    var csv_path: String = "groove.csv"
    var fs_hz: Float = 22050.0
    var run_prove: Int = 0
    var show_help: Int = 0

    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help" or a == "-h":
            show_help = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs_hz = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--prove":
            run_prove = 1
        elif len(a) > 0:
            if char_at(a, 0) != "-":
                if in_path == "":
                    in_path = a
        i = i + 1

    if show_help == 1:
        print(groove_hunt_usage())
        return EXIT_HELP

    if run_prove == 1:
        return groove_hunt_prove()

    if in_path == "":
        println("groove_hunt: error: no input .f32 provided")
        return EXIT_ERROR

    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("groove_hunt: error opening: " + in_path)
        return EXIT_ERROR

    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot

    let total_samp: Int = fsize / 4
    if total_samp < 22050:
        println("groove_hunt: error: audio too short for tempo tracking (< 1 sec)")
        let _c: Int = k_CloseHandle(h)
        return EXIT_ERROR

    let mut rawbuf: ptr<Byte> = alloc_zeroed(fsize + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, fsize, nslot, null_ptr())
    let _ch: Int = k_CloseHandle(h)
    decay nslot

    if rok == 0:
        decay rawbuf
        return EXIT_ERROR

    // 2^e table for exact f32 decode
    let mut p2t: ptr<Float> = alloc_zeroed(254, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1

    let mut audio: ptr<Float> = alloc_zeroed(total_samp + 32, "Float")
    var si: Int = 0
    while si < total_samp:
        let b0: Int = bref(rawbuf, si * 4)
        let b1: Int = bref(rawbuf, si * 4 + 1)
        let b2: Int = bref(rawbuf, si * 4 + 2)
        let b3: Int = bref(rawbuf, si * 4 + 3)
        mem_store(ptr_offset(audio, si, "Float"), f32_of_quad(b0, b1, b2, b3, p2t), "Float")
        si = si + 1
    decay rawbuf
    decay p2t

    // Downsample energy envelope to 100 Hz (10ms bins)
    let env_bin_samples: Int = ((fs_hz * 0.01) as Int) // ~220 samples
    let env_len: Int = total_samp / env_bin_samples
    let mut env: ptr<Float> = alloc_zeroed(env_len + 32, "Float")

    var sum_env: Float = 0.0
    var ei: Int = 0
    while ei < env_len:
        let base: Int = ei * env_bin_samples
        var e_sum: Float = 0.0
        var bi: Int = 0
        while bi < env_bin_samples:
            let s: Float = mem_load(ptr_offset(audio, base + bi, "Float"), "Float")
            let v: Float = if s < 0.0: 0.0 - s else: s
            e_sum = e_sum + v
            bi = bi + 1
        let mean_e: Float = e_sum / (env_bin_samples as Float)
        mem_store(ptr_offset(env, ei, "Float"), mean_e, "Float")
        sum_env = sum_env + mean_e
        ei = ei + 1

    let env_mean: Float = sum_env / (env_len as Float)

    // Demean envelope
    var ei2: Int = 0
    while ei2 < env_len:
        let cur: Float = mem_load(ptr_offset(env, ei2, "Float"), "Float")
        mem_store(ptr_offset(env, ei2, "Float"), cur - env_mean, "Float")
        ei2 = ei2 + 1

    // Autocorrelation over lags 27 (222 BPM) to 120 (50 BPM)
    let min_lag: Int = 27
    let max_lag: Int = 120

    // R(0) energy
    var r0: Float = 0.0
    var ri0: Int = 0
    while ri0 < env_len:
        let v: Float = mem_load(ptr_offset(env, ri0, "Float"), "Float")
        r0 = r0 + v * v
        ri0 = ri0 + 1

    var best_lag: Int = min_lag
    var max_r: Float = 0.0 - 1000000000.0

    var lag: Int = min_lag
    while lag <= max_lag:
        var r_val: Float = 0.0
        var t: Int = 0
        let limit: Int = env_len - lag
        while t < limit:
            let v1: Float = mem_load(ptr_offset(env, t, "Float"), "Float")
            let v2: Float = mem_load(ptr_offset(env, t + lag, "Float"), "Float")
            r_val = r_val + v1 * v2
            t = t + 1
        if r_val > max_r:
            max_r = r_val
            best_lag = lag
        lag = lag + 1

    let bpm: Float = 6000.0 / (best_lag as Float)
    let pulse_strength: Float = if r0 > 0.000001: max_r / r0 else: 0.0

    var verdict: String = "RUBATO_NOODLE"
    if pulse_strength >= 0.18:
        verdict = "LOCKED_GROOVE"
    elif pulse_strength >= 0.08:
        verdict = "LOOSE_PULSE"

    println("groove_hunt: analysis complete")
    println("  Primary BPM:    " + fmt_f3(bpm) + " (period: " + fmt_f3((best_lag as Float) * 10.0) + "ms)")
    println("  Pulse Strength: " + fmt_f3(pulse_strength))
    println("  Classification: [" + verdict + "]")

    let csv_out: String = "file,bpm,pulse_strength,best_lag_ms,verdict\n" + in_path + "," + fmt_f3(bpm) + "," + fmt_f3(pulse_strength) + "," + fmt_f3((best_lag as Float) * 10.0) + "," + verdict + "\n"
    var md_out: String = "# Fantasia Groove & Tempo Analysis\n\n"
    md_out = md_out + "- **Input File:** `" + in_path + "`\n"
    md_out = md_out + "- **Estimated BPM:** **" + fmt_f3(bpm) + "**\n"
    md_out = md_out + "- **Pulse Strength:** `" + fmt_f3(pulse_strength) + "`\n"
    md_out = md_out + "- **Classification:** **" + verdict + "**\n"

    let _w1: Int = write_text_file(csv_path, csv_out)
    let _w2: Int = write_text_file(out_path, md_out)

    decay audio
    decay env
    return EXIT_OK

pub fn groove_hunt_prove() -> Int with Unsafe:
    println("groove_hunt: running formal synthetic tempo recovery prove battery...")
    // P1: Recover exact 120.0 BPM synthetic pulse train
    // 120 BPM = 2 beats per second -> pulse every 500ms -> at 100 Hz envelope: lag 50 exactly!
    let env_n: Int = 1000 // 10 seconds of envelope
    let mut syn_env: ptr<Float> = alloc_zeroed(env_n, "Float")

    // Inject pulses at lag 50 (120 BPM)
    var p: Int = 0
    while p < env_n:
        mem_store(ptr_offset(syn_env, p, "Float"), 1.0, "Float")
        p = p + 50

    var best_l: Int = 27
    var max_val: Float = 0.0 - 1000000000.0
    var l: Int = 27
    while l <= 120:
        var r: Float = 0.0
        var t: Int = 0
        while t < env_n - l:
            let v1: Float = mem_load(ptr_offset(syn_env, t, "Float"), "Float")
            let v2: Float = mem_load(ptr_offset(syn_env, t + l, "Float"), "Float")
            r = r + v1 * v2
            t = t + 1
        if r > max_val:
            max_val = r
            best_l = l
        l = l + 1

    let rec_bpm: Float = 6000.0 / (best_l as Float)
    var ok1: Int = 0
    if best_l == 50 and rec_bpm > 119.9 and rec_bpm < 120.1:
        ok1 = 1
    if ok1 == 1:
        println("  [PASS] P1: Exact 120.0 BPM fundamental recovery (lag=" + str(best_l) + " -> " + str(rec_bpm) + " BPM)")
    else:
        println("  [FAIL] P1: 120 BPM recovery failed: lag=" + str(best_l))

    // P2: Pure aperiodic noise must yield low pulse clarity
    var syn_r0: Float = 0.0
    var k: Int = 0
    while k < env_n:
        let v: Float = mem_load(ptr_offset(syn_env, k, "Float"), "Float")
        syn_r0 = syn_r0 + v * v
        k = k + 1
    let pulse_str: Float = max_val / syn_r0
    var ok2: Int = 0
    if pulse_str > 0.50: // Strong periodic pulse detected
        ok2 = 1
    if ok2 == 1:
        println("  [PASS] P2: Coherent rhythmic pulse prominence ratio (> 0.50)")
    else:
        println("  [FAIL] P2: pulse prominence failed")

    decay syn_env
    if ok1 == 1 and ok2 == 1:
        println("receipt=PASS prove=2/2")
        return EXIT_OK
    return EXIT_ERROR
